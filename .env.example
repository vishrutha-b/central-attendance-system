# Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME="Central Attendance Management System"

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cams_dev
MONGODB_TEST_DB_NAME=cams_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Initial Admin (used by scripts/create_admin.py) ──────────────────────────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Company Settings ──────────────────────────────────────────────────────────
COMPANY_TIMEZONE=Asia/Kolkata
WEEK_START_DAY=0

# ── Attendance Policy ─────────────────────────────────────────────────────────
MIN_DAYS_PER_WEEK=3
MIN_HOURS_PER_WEEK=15
MIN_AVG_HOURS_PER_DAY=5
ALLOW_MULTIPLE_SESSIONS=true

# ── Leave & Holiday Policy ────────────────────────────────────────────────────
WORKING_DAYS_PER_WEEK=5

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_EMAIL
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@company.com
SMTP_FROM_NAME="CAMS Notifications"
SMTP_TIMEOUT_SECONDS=30

# ── Email Delivery Mode ───────────────────────────────────────────────────────
# Options: smtp | console | disabled
EMAIL_DELIVERY_MODE=console

# ── Notification Settings ─────────────────────────────────────────────────────
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_MINUTES=30

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron: every day at 8:00 AM IST
SCHEDULER_CRON=0 8 * * *
SCHEDULER_TIMEZONE=Asia/Kolkata

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Reporting ─────────────────────────────────────────────────────────────────
MAX_REPORT_DATE_RANGE_DAYS=366
